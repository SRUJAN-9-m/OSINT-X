# Copy to .env and fill in only the keys you legitimately hold.
# Every integration works without its key present -- it just reports
# itself as "unavailable" instead of running.

# GitHub public API (raises your rate limit from 60/hr to 5000/hr)
GITHUB_TOKEN=

# HaveIBeenPwned API v3 (paid) - used ONLY to report breach *names/dates*,
# never leaked credentials/passwords.
HIBP_API_KEY=

# Any licensed search API you use for the search-engine-intelligence module
# (e.g. Bing Web Search API, SerpAPI, etc.)
SEARCH_API_KEY=
SEARCH_API_PROVIDER=

# App/database config
DATABASE_URL=sqlite:///./osint_x.db
REQUEST_TIMEOUT_SECONDS=10
RATE_LIMIT_PER_HOST_PER_MINUTE=20
USER_AGENT=OSINT-X/1.0 (+authorized-investigation-tool; contact: you@example.com)
LOCAL_ONLY_MODE=true
DATA_RETENTION_DAYS=90
